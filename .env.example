# Optional. Default database is SQLite file backend/dams.db
# DATABASE_URL=sqlite:///./dams.db

# Allowed browser origins (comma separated). The default works with `npm run dev`.
# CORS_ORIGINS=http://localhost:5173

# Approvers normally cannot approve their own documents. Set to true for a one-person demo.
# ALLOW_SELF_APPROVAL=false

# ---- Optional AI assistance (the app works fully without it) ----
# AI_PROVIDER=anthropic        # or: openai (any OpenAI-compatible endpoint)
# AI_API_KEY=your-secret-key   # keep this server-side; it is never sent to the browser
# AI_MODEL=claude-sonnet-5-5   # required for openai
# AI_BASE_URL=                 # optional override
